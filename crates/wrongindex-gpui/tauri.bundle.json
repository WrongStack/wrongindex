{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "WrongStack",
    "copyright": "MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Local codebase indexing service for WrongStack",
    "longDescription": "WrongIndex keeps WrongStack-compatible code indexes current in the background: one service per user, a native desktop window, and a CLI.",
    "licenseFile": "../../LICENSE",
    "resources": {
      "binaries/THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt"
    },
    "externalBin": [
      "binaries/wrongindexd",
      "binaries/wrongindex"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
